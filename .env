# ==============================================================================
# LAUNCH VEHICLE HEALTH MONITOR — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your project credentials from the Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Note: The app automatically falls back to the built-in Exhibition DEMO Simulation Mode
# if Firebase credentials are omitted or during offline testing.
